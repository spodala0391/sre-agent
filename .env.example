# Token Factory
NEBIUS_API_KEY=replace-me
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Paste exact IDs from scripts/list-models.sh
M_NANO=replace-with-nemotron-nano-id
M_SUPER=replace-with-nemotron-super-id
M_ULTRA=replace-with-nemotron-ultra-id

# Cluster
TARGET_NAMESPACES=app
PROMETHEUS_URL=http://mon-kube-prometheus-stack-prometheus.monitoring:9090

# Behaviour
ESCALATION_CONFIDENCE=0.7
MAX_TOOL_ROUNDS=8
AUTO_REMEDIATE=false
DRY_RUN=false

# Required whenever the agent is reachable from outside the cluster (tunnel / Nebius endpoint).
# Generate with: openssl rand -hex 24
AGENT_TOKEN=

# Optional: extra JSON sent with every request per tier, e.g. to turn reasoning off for Nano.
# Check the model card on Token Factory for the exact switch your Nemotron version uses.
# EXTRA_BODY_NANO={"chat_template_kwargs": {"enable_thinking": false}}
